{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "WorktreeCreate": [
      { "hooks": [{ "type": "command", "command": "/usr/src/app/docker/rails/claude-worktree-hook" }] }
    ]
  }
}