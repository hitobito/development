#!/usr/bin/env bash
#
# Start an AI coding agent inside the dev environment's sandbox container.
#
#   bin/agent [claude|opencode] [args...]
#
# Works from the development directory, from hitobito/, from any wagon and from any worktree:
# the container's working directory mirrors the one you call this from.

set -euo pipefail

root="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
here="$(pwd -P)"

case "$here" in
  "$root") workdir="/usr/src/app/hitobito" ;;      # no repo selected, default to the core
  "$root"/*) workdir="/usr/src/app${here#"$root"}" ;;
  *) echo "bin/agent must be called from inside $root" >&2; exit 1 ;;
esac

# Any database counts, because the agent can reach every database on the postgres server.
# A plain `docker run` on just the seed volume starts much faster than `docker compose run`.
project="$(docker compose --project-directory "$root" config | sed -n 's/^name: //p')"
seed_volume="$(docker volume ls -q --filter "label=com.docker.compose.project=$project" \
  --filter label=com.docker.compose.volume=seed)"
dumps=""
if [ -n "$seed_volume" ]; then
  dumps="$(docker run --rm -v "$seed_volume:/seed:ro" --entrypoint sh \
    ghcr.io/hitobito/development/rails -c 'cd /seed && ls dump-in-*' 2>/dev/null || true)"
fi

if [ -n "$dumps" ]; then
  cat >&2 <<EOF

Refusing to start an agent: a database dump has been loaded into ${dumps//dump-in-/}.

Agents must not run against dumps, which may contain production data.

To get back to a clean state:
  docker compose down --volumes && docker compose up

If you are certain this dump is safe, remove the marker:
  docker compose run --rm --no-deps --entrypoint bash rails -c 'rm /seed/dump-in-*'

EOF
  exit 1
fi

if command -v git >/dev/null; then
  mkdir -p "$root/docker/rails/home/.config/git"
  for key in user.name user.email; do
    if value="$(git -C "$here" config "$key")"; then
      git config --file "$root/docker/rails/home/.config/git/config" "$key" "$value"
    fi
  done
fi

agent="${1:-claude}"
shift || true

exec docker compose --project-directory "$root" \
  run --rm --interactive --tty --workdir "$workdir" agent "$agent" "$@"
